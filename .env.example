# =============================================================
# Malerwerkstätte Frey — Environment Variables
# Kopieren Sie diese Datei als .env.local und füllen Sie die
# Werte aus. Commiten Sie NIEMALS echte Tokens.
# =============================================================

# Replicate API Token (https://replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=

# Replicate-Segmentierungsmodell (Standard: meta/sam-2)
# Alternativ: lucataco/segment-anything-2 falls interaktive Punkt-Eingabe benötigt
# WICHTIG: Verifizieren Sie das exakte Input-/Output-Schema unter
#   https://replicate.com/meta/sam-2/api
REPLICATE_SEGMENTATION_MODEL=meta/sam-2

# Farbdesigner aktivieren (true/false)
# Bei false antwortet /api/segment mit 503, ohne Replicate aufzurufen.
FARBDESIGNER_ENABLED=true
